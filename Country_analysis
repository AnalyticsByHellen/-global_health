-- Which countries have the largest affected populations?
SELECT 
    Country,
    SUM(Population_Affected) AS Total_Population
FROM global_health_statistics
GROUP BY  Country
ORDER BY Total_Population DESC;

-- Which countries have the highest average prevalence rate
SELECT 
    Country,
   ROUND(AVG(Prevalence_Rate), 2) AS Prevalence_Rate
FROM global_health_statistics
GROUP BY  Country
ORDER BY Prevalence_Rate;

-- Which countries have the highest average mortality rate
SELECT 
    Country,
   ROUND(AVG(Mortality_Rate), 2) AS Mortality_Rate
FROM global_health_statistics
GROUP BY  Country
ORDER BY Mortality_Rate;

-- Which countries have the highest average recovery rate
SELECT 
    Country,
   ROUND(AVG(Recovery_Rate), 2) AS Recovery_Rate
FROM global_health_statistics
GROUP BY  Country
ORDER BY Recovery_Rate;

-- Which countries have the highest total DALYs?
SELECT 
    Country,
   ROUND(AVG(DALYs), 2) AS DALYs
FROM global_health_statistics
GROUP BY  Country
ORDER BY DALYs;

-- Which countries have the best healthcare access?
SELECT 
    Country,
   ROUND(AVG(Healthcare_Access), 2) AS Healthcare_Acess
FROM global_health_statistics
GROUP BY  Country
ORDER BY Healthcare_Acess DESC
LIMIT 5;

-- Which countries have the LOW healthcare access?
SELECT 
    Country,
   ROUND(AVG(Healthcare_Access), 2) AS Healthcare_Acess
FROM global_health_statistics
GROUP BY  Country
ORDER BY Healthcare_Acess ASC
LIMIT 5;

-- Which countries have the most doctors per 1,000 people?
SELECT 
    Country,
   ROUND(AVG(Doctors_per_1000), 2) AS Doctors_per_people
FROM global_health_statistics
GROUP BY  Country
ORDER BY Doctors_per_people DESC
LIMIT 10;

-- Which countries have the most hospital beds per 1,000 people?
SELECT 
    Country,
   ROUND(AVG(Hospital_Beds_per_1000), 2) AS hospitalbeds
FROM global_health_statistics
GROUP BY  Country
ORDER BY hospitalbeds DESC
LIMIT 10;
