-- Do countries with more hospital beds have lower mortality rates?
SELECT
    Country,
    ROUND(AVG(Hospital_Beds_per_1000), 2) AS Avg_Hospitalbed,
    ROUND(AVG(Mortality_rate), 2) AS Avg_Mortality_Rate
FROM global_health_statistics
GROUP BY Country
ORDER BY Avg_Hospitalbed  DESC;

SELECT
    ROUND(
        (COUNT(*) * SUM(Hospital_Beds_per_1000 * Mortality_Rate)
        - SUM(Hospital_Beds_Per_1000) * SUM(Mortality_Rate))
        /
        SQRT(
            (COUNT(*) * SUM(Hospital_Beds_per_1000 * Hospital_Beds_per_1000)
            - POW(SUM(Hospital_Beds_per_1000), 2))
            *
            (COUNT(*) * SUM(Mortality_Rate * Mortality_Rate)
            - POW(SUM(Mortality_Rate), 2))
        ),
        3
    ) AS Beds_Mortality_Correlation
FROM global_health_statistics;

-- Which countries have low healthcare access but high mortality?
SELECT
    Country,
    ROUND(AVG(Healthcare_Access), 2) AS Avg_Healthcare_Access,
    ROUND(AVG(Mortality_Rate), 2) AS Avg_Mortality_Rate
FROM global_health_statistics
GROUP BY Country
HAVING AVG(Healthcare_Access) < (
           SELECT AVG(Healthcare_Access)
           FROM global_health_statistics
       )
   AND AVG(Mortality_Rate) > (
           SELECT AVG(Mortality_Rate)
           FROM global_health_statistics
       )
ORDER BY Avg_Mortality_Rate DESC; 

-- Which countries have high healthcare access but unexpectedly high mortality?
SELECT
    Country,
    ROUND(AVG(Healthcare_Access), 2) AS Avg_Healthcare_Access,
    ROUND(AVG(Mortality_Rate), 2) AS Avg_Mortality_Rate
FROM global_health_statistics
GROUP BY Country
HAVING AVG(Healthcare_Access) > (
           SELECT AVG(Healthcare_Access)
           FROM global_health_statistics
       )
   AND AVG(Mortality_Rate) > (
           SELECT AVG(Mortality_Rate)
           FROM global_health_statistics
       )
ORDER BY Avg_Mortality_Rate DESC; 

-- Which countries have both high healthcare access and high recovery rates?
SELECT
    Country,
    ROUND(AVG(Healthcare_Access), 2) AS Avg_Healthcare_Access,
    ROUND(AVG(Recovery_Rate), 2) AS Avg_Recovery_Rate
FROM global_health_statistics
GROUP BY Country
HAVING AVG(Healthcare_Access) > (
           SELECT AVG(Healthcare_Access)
           FROM global_health_statistics
       )
   AND AVG(Recovery_Rate) > (
           SELECT AVG(Recovery_Rate)
           FROM global_health_statistics
       )
