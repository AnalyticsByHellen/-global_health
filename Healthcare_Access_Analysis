-- Does higher healthcare access correspond with higher recovery rates?

SELECT
    Country,
    ROUND(AVG(Healthcare_Access), 2) AS Avg_Healthcare_Access,
    ROUND(AVG(Recovery_Rate), 2) AS Avg_Recovery_Rate
FROM global_health_statistics
GROUP BY Country
ORDER BY Avg_Healthcare_Access DESC;

SELECT
    ROUND(
        (COUNT(*) * SUM(Healthcare_Access * Recovery_Rate)
        - SUM(Healthcare_Access) * SUM(Recovery_Rate))
        /
        SQRT(
            (COUNT(*) * SUM(Healthcare_Access * Healthcare_Access)
            - POW(SUM(Healthcare_Access), 2))
            *
            (COUNT(*) * SUM(Recovery_Rate * Recovery_Rate)
            - POW(SUM(Recovery_Rate), 2))
        ),
        3
    ) AS Correlation
FROM global_health_statistics;

-- Do countries with more doctors have lower mortality rates?
SELECT
    Country,
    ROUND(AVG(Doctors_per_1000), 2) AS Avg_Doctors,
    ROUND(AVG(Mortality_rate), 2) AS Avg_Mortality_Rate
FROM global_health_statistics
GROUP BY Country
ORDER BY  Avg_Doctors DESC;

SELECT
    ROUND(
        (COUNT(*) * SUM(Doctors_per_1000 * Mortality_Rate)
        - SUM(Doctors_per_1000) * SUM(Mortality_Rate))
        /
        SQRT(
            (COUNT(*) * SUM(Doctors_per_1000 * Doctors_per_1000)
            - POW(SUM(Doctors_per_1000), 2))
            *
            (COUNT(*) * SUM(Mortality_Rate * Mortality_Rate)
            - POW(SUM(Mortality_Rate), 2))
        ),
        3
    ) AS Doctor_Mortality_Correlation
FROM global_health_statistics;

