-- Which countries appear to be improving most over the 5-year period?
SELECT
Country,
     ROUND(AVG (Improvement_5_Years), 2) AS Average_Improvement_5_Years
	
FROM global_health_statistics
GROUP BY Country 
ORDER BY Average_Improvement_5_Years  DESC
LIMIT 10;

-- Which diseases show the greatest improvement over 5 years?
SELECT
Disease_Name,
     ROUND(AVG (Improvement_5_Years), 2) AS Average_Improvement_5_Years
	
FROM global_health_statistics
GROUP BY Disease_Name
ORDER BY Average_Improvement_5_Years  DESC
LIMIT 10;

-- Which diseases should potentially receive the greatest healthcare attention based on prevalence, mortality and DALYs?
SELECT
    Disease_Name,
    ROUND(AVG(Prevalence_Rate), 2) AS Average_Prevalence_Rate,
    ROUND(AVG(Mortality_Rate), 2) AS Average_Mortality_Rate,
    SUM(DALYs) AS Total_DALYs
FROM global_health_statistics
GROUP BY Disease_Name
HAVING
    AVG(Prevalence_Rate) > (
        SELECT AVG(Prevalence_Rate)
        FROM global_health_statistics
    )
    AND AVG(Mortality_Rate) > (
        SELECT AVG(Mortality_Rate)
        FROM global_health_statistics
    )
    AND SUM(DALYs) > (
        SELECT AVG(Disease_DALYs)
        FROM (
            SELECT
                Disease_Name,
                SUM(DALYs) AS Disease_DALYs
            FROM global_health_statistics
            GROUP BY Disease_Name
        ) AS Disease_Totals
    )
ORDER BY Total_DALYs DESC;
